# ─── Database (Render-Managed PostgreSQL) ───
# Internal URL (preferred when running inside Render private network):
# DATABASE_URL="postgresql://USER:PASSWORD@dpg-xxxx-a:5432/DATABASE"
# External URL (for local development or external administration with TLS):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── Authentication ───
AUTH_SECRET=your-secret-key-min-32-characters-long-here

# ─── Razorpay (Test Mode) ───
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# ───# xAI Grok Configuration
AI_PROVIDER="grok"
GROK_API_KEY="xai-your-grok-api-key"
GROK_MODEL="grok-2-latest"

# ─── Application ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
